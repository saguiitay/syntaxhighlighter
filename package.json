{
	"name": "syntaxhighlighter-prism",
	"version": "4.0.1",
	"private": true,
	"description": "Backward-compatible WordPress code highlighting with local Prism grammars, TypeScript and Kusto.",
	"license": "GPL-2.0-or-later",
	"repository": "github:saguiitay/syntaxhighlighter",
	"engines": {
		"node": ">=24.18",
		"npm": ">=11.16"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"archive": "node scripts/package.mjs",
		"test": "node --test tests/unit/*.test.mjs",
		"test:browser": "playwright test",
		"test:php": "node scripts/test-php.mjs",
		"test:wordpress": "node scripts/test-wordpress.mjs",
		"test:package": "node scripts/test-package.mjs",
		"benchmark": "node scripts/benchmark.mjs",
		"lint": "eslint src scripts tests --no-warn-ignored",
		"format:check": "prettier --check src/frontend.js src/frontend.css scripts tests/unit tests/browser *.mjs package.json languages.json .github/workflows",
		"audit": "npm audit --omit=optional",
		"check": "npm run build && npm test && npm run lint && npm run format:check && npm run test:php && npm run test:browser"
	},
	"dependencies": {
		"prismjs": "1.30.0"
	},
	"devDependencies": {
		"@php-wasm/node": "3.1.63",
		"@php-wasm/universal": "3.1.63",
		"@playwright/test": "1.58.2",
		"@wp-playground/cli": "3.1.63",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"fflate": "0.8.3",
		"prettier": "3.8.2"
	},
	"overrides": {
		"body-parser": "1.20.9",
		"fast-uri": "3.1.9",
		"isomorphic-git": "1.44.12",
		"proxy-addr": "2.0.8",
		"qs": "6.17.1"
	}
}
